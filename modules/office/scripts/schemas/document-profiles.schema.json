{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profiles",
    "bindings"
  ],
  "properties": {
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organization_id",
          "path",
          "sha256",
          "version"
        ],
        "properties": {
          "organization_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_type",
          "organization_id",
          "template_id"
        ],
        "properties": {
          "document_type": {
            "enum": [
              "letter",
              "proposal",
              "act",
              "meeting_protocol",
              "production_spec",
              "digital_spec"
            ]
          },
          "organization_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "template_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
