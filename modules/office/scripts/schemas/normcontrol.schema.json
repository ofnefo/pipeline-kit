{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_code",
    "scope_statement",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "scope_statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement",
          "acceptance",
          "standard",
          "applicability",
          "applicability_basis",
          "state",
          "artifact",
          "locations",
          "coverage",
          "evidence",
          "reviewer",
          "checked_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "acceptance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "standard": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identifier",
              "edition",
              "authoritative_url",
              "clause",
              "source_verification",
              "verification_source"
            ],
            "properties": {
              "identifier": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "edition": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "authoritative_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri",
                "pattern": "^https://"
              },
              "clause": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "source_verification": {
                "enum": [
                  "verified",
                  "not_verified"
                ]
              },
              "verification_source": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000,
                        "pattern": "\\S"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "applicability": {
            "enum": [
              "applicable",
              "not_applicable",
              "undetermined"
            ]
          },
          "applicability_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "state": {
            "enum": [
              "conforming",
              "nonconformity",
              "missing_evidence",
              "not_checked",
              "not_applicable"
            ]
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "coverage": {
            "enum": [
              "sample",
              "all_declared_locations"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "location"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "location": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "\\S"
                }
              }
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
