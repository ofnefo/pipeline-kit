{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-pipeline/ttn-input/1",
  "title": "Транспортная накладная (ПП РФ №2200, прил. 4) — входные данные",
  "description": "Every field is optional except schema_version and cargo.lines[].name; absent or null values stay empty in the form. Decimals are strings ('12,5' or '12.5').",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "$defs": {
    "text": {"type": ["string", "null"], "maxLength": 4000},
    "date": {"type": ["string", "null"], "format": "date"},
    "dec": {"type": ["string", "null"], "pattern": "^[0-9]{1,13}([.,][0-9]{1,4})?$"},
    "count": {"type": ["integer", "null"], "minimum": 0},
    "texts": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "signer": {"type": "object", "additionalProperties": false,
      "properties": {"entity": {"$ref": "#/$defs/text"}, "basis": {"$ref": "#/$defs/text"},
                     "signatory": {"$ref": "#/$defs/text"}, "authority": {"$ref": "#/$defs/text"}}}
  },
  "properties": {
    "schema_version": {"const": 1},
    "waybill": {"type": "object", "additionalProperties": false,
      "properties": {"date": {"$ref": "#/$defs/date"}, "number": {"$ref": "#/$defs/text"}}},
    "order": {"type": "object", "additionalProperties": false,
      "properties": {"date": {"$ref": "#/$defs/date"}, "number": {"$ref": "#/$defs/text"}}},
    "copy_number": {"$ref": "#/$defs/text"},
    "shipper": {"type": "object", "additionalProperties": false,
      "properties": {"details": {"$ref": "#/$defs/text"}, "is_forwarder": {"type": ["boolean", "null"]}}},
    "customer": {"type": "object", "additionalProperties": false,
      "properties": {"details": {"$ref": "#/$defs/text"}, "settlement_basis": {"$ref": "#/$defs/text"},
                     "contract": {"$ref": "#/$defs/text"}}},
    "consignee": {"type": "object", "additionalProperties": false,
      "properties": {"details": {"$ref": "#/$defs/text"}, "delivery_address": {"$ref": "#/$defs/text"}}},
    "cargo": {"type": "object", "additionalProperties": false,
      "properties": {
        "dangerous_info": {"$ref": "#/$defs/text"},
        "lines": {"type": "array", "maxItems": 2000, "items": {"type": "object", "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 1000},
            "group": {"$ref": "#/$defs/text"}, "serial": {"$ref": "#/$defs/text"},
            "state_info": {"$ref": "#/$defs/text"}, "places": {"$ref": "#/$defs/count"},
            "marking": {"$ref": "#/$defs/text"}, "packaging": {"$ref": "#/$defs/text"},
            "gross_kg": {"$ref": "#/$defs/dec"}, "net_kg": {"$ref": "#/$defs/dec"},
            "dimensions_m": {"$ref": "#/$defs/text"}, "volume_m3": {"$ref": "#/$defs/dec"},
            "density": {"$ref": "#/$defs/text"}, "extra": {"$ref": "#/$defs/text"},
            "dangerous_info": {"$ref": "#/$defs/text"}, "declared_value": {"$ref": "#/$defs/dec"},
            "note": {"$ref": "#/$defs/text"}}}}}},
    "documents": {"type": "object", "additionalProperties": false,
      "properties": {"regulated": {"$ref": "#/$defs/texts"}, "certificates": {"$ref": "#/$defs/texts"},
                     "shipment_docs": {"$ref": "#/$defs/texts"}}},
    "instructions": {"type": "object", "additionalProperties": false,
      "properties": {"route_and_terms": {"$ref": "#/$defs/text"}, "readdress_contacts": {"$ref": "#/$defs/text"},
                     "regulatory": {"$ref": "#/$defs/text"}, "temperature_seals": {"$ref": "#/$defs/text"}}},
    "carrier": {"type": "object", "additionalProperties": false,
      "properties": {"details": {"$ref": "#/$defs/text"},
        "drivers": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false,
          "required": ["name"],
          "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 300},
                         "license": {"$ref": "#/$defs/text"}, "phone": {"$ref": "#/$defs/text"},
                         "details": {"$ref": "#/$defs/text"}}}}}},
    "vehicle": {"type": "object", "additionalProperties": false,
      "properties": {"type": {"$ref": "#/$defs/text"}, "brand": {"$ref": "#/$defs/text"},
                     "capacity_t": {"$ref": "#/$defs/dec"}, "volume_m3": {"$ref": "#/$defs/dec"},
                     "reg_number": {"$ref": "#/$defs/text"}, "trailer": {"$ref": "#/$defs/text"},
                     "ownership_type": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
                     "ownership_docs": {"$ref": "#/$defs/text"}, "special_permit": {"$ref": "#/$defs/text"}}},
    "loading": {"type": "object", "additionalProperties": false,
      "properties": {"loader": {"$ref": "#/$defs/text"}, "infrastructure_owner": {"$ref": "#/$defs/text"},
                     "address": {"$ref": "#/$defs/text"}, "planned_at": {"$ref": "#/$defs/text"},
                     "arrived_at": {"$ref": "#/$defs/text"}, "departed_at": {"$ref": "#/$defs/text"},
                     "gross_kg": {"$ref": "#/$defs/dec"}, "gross_method": {"$ref": "#/$defs/text"},
                     "places": {"$ref": "#/$defs/count"}, "packaging": {"$ref": "#/$defs/text"},
                     "carrier_remarks": {"$ref": "#/$defs/text"}, "loader_signatory": {"$ref": "#/$defs/text"},
                     "driver_signatory": {"$ref": "#/$defs/text"}}},
    "readdress": {"type": "object", "additionalProperties": false,
      "properties": {"date_and_kind": {"$ref": "#/$defs/text"}, "new_address_and_time": {"$ref": "#/$defs/text"},
                     "instructed_by": {"$ref": "#/$defs/text"}, "new_consignee": {"$ref": "#/$defs/text"}}},
    "delivery": {"type": "object", "additionalProperties": false,
      "properties": {"address": {"$ref": "#/$defs/text"}, "planned_at": {"$ref": "#/$defs/text"},
                     "arrived_at": {"$ref": "#/$defs/text"}, "departed_at": {"$ref": "#/$defs/text"},
                     "condition": {"$ref": "#/$defs/text"}, "places": {"$ref": "#/$defs/count"},
                     "gross_kg": {"$ref": "#/$defs/dec"}, "net_kg": {"$ref": "#/$defs/dec"},
                     "density": {"$ref": "#/$defs/text"}, "carrier_remarks": {"$ref": "#/$defs/text"},
                     "consignee_signatory": {"$ref": "#/$defs/text"}, "driver_signatory": {"$ref": "#/$defs/text"}}},
    "marks": {"type": "object", "additionalProperties": false,
      "properties": {"description": {"$ref": "#/$defs/text"}, "penalty": {"$ref": "#/$defs/text"},
                     "signature_date": {"$ref": "#/$defs/text"}}},
    "cost": {"type": "object", "additionalProperties": false,
      "properties": {"without_tax": {"$ref": "#/$defs/dec"}, "tax_rate": {"$ref": "#/$defs/text"},
                     "tax_amount": {"$ref": "#/$defs/dec"}, "with_tax": {"$ref": "#/$defs/dec"},
                     "calculation_method": {"$ref": "#/$defs/text"}, "payer": {"$ref": "#/$defs/text"},
                     "carrier": {"$ref": "#/$defs/signer"}, "shipper": {"$ref": "#/$defs/signer"}}}
  }
}
